<Window x:Class="GlassLingo.Overlay.ResultOverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource ui001}" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" Focusable="True" Width="520" MaxHeight="620" SizeToContent="Height" WindowStartupLocation="Manual" FontFamily="{DynamicResource UiFont}">
  <Border x:Name="Card" Focusable="True" Background="#FA171C24" BorderBrush="#526177" BorderThickness="1" CornerRadius="20" Padding="20,16">
    <StackPanel>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="HeaderText" Text="{DynamicResource ui002}" FontSize="13" Foreground="#AFC5E5" VerticalAlignment="Center"/><Button Grid.Column="1" Content="{DynamicResource ui003}" Click="Copy_Click" Padding="10,5" FontSize="12" Margin="0,0,8,0"/><Button Grid.Column="2" Click="Close_Click" Padding="8,7" ToolTip="{DynamicResource ui004}"><Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#D6DFEC" StrokeThickness="1.5" Width="10" Height="10"/></Button></Grid>
      <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
        <TextBlock x:Name="TranslatedText" Foreground="#F2F5FA" FontSize="19" LineHeight="30" TextWrapping="Wrap"/>
        <Border x:Name="SepLine" Height="1" Background="#354151" Margin="0,16,0,12" Visibility="Collapsed"/>
        <Expander Header="{DynamicResource ui005}" Foreground="#B0BED1" FontSize="12"><TextBlock x:Name="BodyText" Foreground="#B0BED1" FontSize="13" LineHeight="22" TextWrapping="Wrap" Margin="0,10,0,0"/></Expander>
        <Expander Header="{DynamicResource ui006}" Foreground="#94A5BD" FontSize="11" Margin="0,12,0,0"><TextBlock x:Name="FooterText" Foreground="#A8B3C3" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/></Expander>
      </StackPanel></ScrollViewer>
      <TextBlock x:Name="HintText" Foreground="#94A5BD" FontSize="11" Margin="0,16,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0"><CheckBox x:Name="PopupTransparentCheck" Content="{DynamicResource ui319}" Checked="PopupTransparency_Changed" Unchecked="PopupTransparency_Changed" FontSize="11" Margin="0,0,12,0"/><TextBlock Text="{DynamicResource ui007}" FontSize="11" Foreground="#B1C4DC" VerticalAlignment="Center" Margin="0,0,10,0"/><Slider IsEnabled="{Binding IsChecked, ElementName=PopupTransparentCheck}" x:Name="PopupOpacitySlider" Width="130" Minimum="0" Maximum="1" Value="0.22" ValueChanged="PopupOpacity_Changed" PreviewMouseLeftButtonUp="PopupOpacity_Commit" PreviewKeyUp="PopupOpacity_Commit" ToolTip="{DynamicResource ui008}"/></StackPanel>
    </StackPanel>
  </Border>
</Window>
