<Window x:Class="GlassLingo.Overlay.RegionSelectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource ui000}"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#B0000000"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        Cursor="Cross">

    <Canvas x:Name="RootCanvas" Background="Transparent">

        <!-- 已经选中的区域：挖空（透明），让用户看清原文 -->
        <Border x:Name="SelectionRect"
                Background="#00FFFFFF"
                BorderBrush="#FF4EA1FF"
                BorderThickness="2"
                Visibility="Collapsed"/>

        <!-- 尺寸提示，跟着选择框右下角走 -->
        <Border x:Name="SizeChip"
                Background="#E61A1A1A"
                CornerRadius="4"
                Padding="8,4"
                Visibility="Collapsed">
            <TextBlock x:Name="SizeText"
                       Foreground="#FFFFFFFF"
                       FontFamily="Consolas, Microsoft YaHei UI"
                       FontSize="13"/>
        </Border>

        <!-- 顶部操作提示 -->
        <Border x:Name="HintBar"
                Background="#E61A1A1A"
                CornerRadius="6"
                Padding="14,8"
                Canvas.Left="0" Canvas.Top="0">
            <TextBlock Foreground="#FFE8E8E8"
                       FontFamily="Microsoft YaHei UI"
                       FontSize="13">
                拖动鼠标框选要识别的区域　·　<Run Foreground="#FF8AB4F8">Esc</Run> 或 <Run Foreground="#FF8AB4F8">右键</Run> 取消
            </TextBlock>
        </Border>

    </Canvas>
</Window>
